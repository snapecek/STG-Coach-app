{
  "name": "stg-coach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:cloud": "python3 scripts/check-cloud.py",
    "test:ui": "node scripts/check-ui.cjs",
    "test:member-ui": "node scripts/check-member-ui.cjs",
    "test:member-cloud": "python3 scripts/check-member-cloud.py",
    "test:database": "python3 scripts/check-database.py",
    "test:capacity-cloud": "python3 scripts/check-capacity-cloud.py",
    "test:groups-ui": "node scripts/check-groups-ui.cjs",
    "test:race-teams-ui": "node scripts/check-race-teams-ui.cjs",
    "test:journal-share-ui": "node scripts/check-journal-share-dialog.cjs",
    "test:share-editor": "node scripts/check-share-editor.cjs",
    "test:share-ui": "node scripts/check-share-ui.cjs",
    "test:share-touch-ui": "node scripts/check-share-touch-ui.cjs",
    "preview:share-gallery": "node scripts/render-share-gallery.cjs",
    "test:auth-ui": "node scripts/check-auth-persistence.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
